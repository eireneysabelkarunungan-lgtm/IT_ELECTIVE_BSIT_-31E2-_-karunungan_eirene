@{
Layout = null;
ViewData["Title"] = "Welcome";
}

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>@ViewData["Title"] - Webly</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
		<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
	</head>
	<body class="auth-body">
		<div class="auth-card">
			<div class="success-icon">
				<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M4 12.5L9 17.5L20 6.5" stroke="#6ee7b7" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
			</div>
			<p class="eyebrow">Webly &middot; authenticated</p>
			<h1>Welcome!</h1>
			<p class="sub">You have successfully logged in.</p>

			<a asp-controller="Account" asp-action="Login" class="ghost-link">&larr; Back to login</a>
		</div>
	</body>
</html>
